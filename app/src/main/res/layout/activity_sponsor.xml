<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:title="赞助支持"
            app:titleTextColor="?attr/colorOnSurface" />
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:gravity="center_horizontal">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="感谢您使用 WuminPy！"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                android:gravity="center"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="如果您觉得这个应用对您有帮助，欢迎扫码支持开发者"
                android:textSize="14sp"
                android:textColor="?attr/colorOnSurface"
                android:gravity="center"
                android:layout_marginBottom="24dp" />

            <!-- 微信赞赏码 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="微信赞赏"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                android:gravity="center"
                android:layout_marginBottom="12dp" />

            <androidx.cardview.widget.CardView
                android:layout_width="260dp"
                android:layout_height="260dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                android:layout_marginBottom="6dp">

                <ImageView
                    android:id="@+id/iv_wechat_qr"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/sponsor_wechat"
                    android:scaleType="centerCrop"
                    android:contentDescription="微信赞赏码" />
            </androidx.cardview.widget.CardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="👆 长按上方图片即可保存到相册"
                android:textSize="12sp"
                android:textColor="?attr/colorOnSurface"
                android:gravity="center"
                android:alpha="0.6"
                android:layout_marginBottom="28dp" />

            <!-- 支付宝赞赏码 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="支付宝赞赏"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                android:gravity="center"
                android:layout_marginBottom="12dp" />

            <androidx.cardview.widget.CardView
                android:layout_width="260dp"
                android:layout_height="260dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                android:layout_marginBottom="6dp">

                <ImageView
                    android:id="@+id/iv_alipay_qr"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/sponsor_alipay"
                    android:scaleType="centerCrop"
                    android:contentDescription="支付宝赞赏码" />
            </androidx.cardview.widget.CardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="👆 长按上方图片即可保存到相册"
                android:textSize="12sp"
                android:textColor="?attr/colorOnSurface"
                android:gravity="center"
                android:alpha="0.6"
                android:layout_marginBottom="28dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="无论是否赞助，WuminPy 的核心功能都将保持免费使用。\n感谢每一位用户的支持和鼓励！"
                android:textSize="13sp"
                android:textColor="?attr/colorOnSurface"
                android:gravity="center"
                android:alpha="0.7"
                android:layout_marginBottom="24dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="?attr/colorOnSurface"
                android:alpha="0.15"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="联系方式\n\nQQ：1352183717\n微信：liu1352183717\n邮箱：1352183717@qq.com"
                android:textSize="14sp"
                android:textColor="?attr/colorOnSurface"
                android:gravity="center"
                android:autoLink="email"
                android:textIsSelectable="true"
                android:alpha="0.8" />

        </LinearLayout>
    </ScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
